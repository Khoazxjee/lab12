@model IEnumerable<Learner>
@{ ViewData["Title"] = "Danh sách người học"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <h1 class="h3 mb-0">Danh sách người học</h1>
    <a asp-action="Create" class="btn btn-primary">+ Thêm người học</a>
</div>
@if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
<div class="d-flex align-items-center flex-wrap gap-2"><span class="text-muted">Cách tải dữ liệu:</span>
    <div class="btn-group" aria-label="Cách tải dữ liệu">
        <a asp-action="Index" asp-route-mid="@ViewBag.Mid" asp-route-q="@ViewBag.Search" asp-route-mode="sync" class="btn btn-sm @(ViewBag.Mode == "sync" ? "btn-primary" : "btn-outline-primary")">Đồng bộ</a>
        <a asp-action="Index" asp-route-mid="@ViewBag.Mid" asp-route-q="@ViewBag.Search" asp-route-mode="ajax" class="btn btn-sm @(ViewBag.Mode == "ajax" ? "btn-primary" : "btn-outline-primary")">AJAX</a>
    </div>
</div>
@await Component.InvokeAsync("Major")

<div id="content" aria-live="polite" data-endpoint="@Url.Action("LearnerByMajorID", "Learner")" data-mode="@ViewBag.Mode">
    <partial name="LearnerTable" model="Model" />
</div>
@section Scripts {
    <script src="~/js/learner-list.js" asp-append-version="true"></script>
}
